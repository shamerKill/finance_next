# ============================================================
# finance_next — 部署配置
# ============================================================
# 拷贝本文件为 .env 并填入真实值：
#   cp .env.example .env && $EDITOR .env
# 启动前用 infra/scripts/check-env.sh 校验：
#   bash infra/scripts/check-env.sh
#
# 本文件覆盖 gateway + quant + docker-compose 共用的所有 env。
# 详细语义见 CLAUDE.md §7 + §8（mainnet / 安全契约硬约束）。
# ============================================================

# -------------------------
# 必填 (required) — 缺失启动失败
# -------------------------

# Mongo Atlas 连接串（含库名）。
# Example: mongodb+srv://user:pass@cluster.example.net/finance?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongo:27017/finance

# 32-byte hex (64 字符)，AES-256-GCM master KEK。生成：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 改值 = 已有 ciphertext 全部失效（直到 admin 触发 KEK rotate）。
ENCRYPTION_KEY=

# 32-byte hex (64 字符)，JWT signing secret。生成同上。
# 改值 = 所有已签发 token 失效，全员强制重新登录。
AUTH_JWT_SECRET=

# Redis 连接串（订单引擎 + WS 黑名单 + rate-limit）。
# Format: redis://[:password@]host:port[/db]
REDIS_URL=redis://redis:6379/0

# -------------------------
# Auth & 鉴权（required 默认值已设好；prod 需 review）
# -------------------------

AUTH_JWT_TTL_SECONDS=86400         # JWT 寿命（秒）；默认 24h
AUTH_COOKIE_DOMAIN=                # 空 = 同源；多子域填 .example.com
AUTH_COOKIE_SECURE=true            # prod 必 true（HTTPS）；dev http 改 false
ALLOW_S2S_HEADER=false             # **谨慎**：true → X-Admin-Key 可绕过 cookie；
                                   # 开启前必须确认 gateway 不直连公网
REQUIRE_USER_ID=true               # 多租户 X-User-Id header 必填（已与 cookie 配合）

# CORS + WebSocket Origin 白名单（逗号分隔的完整 URL）。
# AllowCredentials=true 与 "*" 互斥，prod 必显式列出。
ALLOWED_ORIGINS=http://localhost:3000

# -------------------------
# Admin（optional）
# -------------------------

# 留空 → /api/v1/admin/* 全部 404 隐藏；非空 → 调用方需带 X-Admin-Key header。
ADMIN_KEY=

# -------------------------
# Mainnet 交易开关（默认全部 false；prod 启用前阅读 CLAUDE.md §8）
# -------------------------

# 必须字面量 "true" 才进入 Binance USDM mainnet gate。即使为 true，
# 仍需 admin 走完 /admin/mainnet/request-token → /confirm 流程。
MAINNET_TRADING_ENABLED=false

# 同样字面量 "true" 才进入 Polymarket mainnet gate。Polymarket 无 testnet，
# token gate 与 Binance 共享同一 TokenStore（confirm 一次开两个 vertical）。
POLYMARKET_TRADING_ENABLED=false

# -------------------------
# Timescale (OHLCV / equity / Phase 8 扩展数据)
# -------------------------

# 空 → /api/v1/market/ohlcv 等读端点 503。
TIMESCALE_DSN=postgres://app:app@timescale:5432/finance

# -------------------------
# Quant gRPC（gateway → python worker）
# -------------------------

# 空 → admin /api/v1/market/ingest 返 503。
QUANT_GRPC_ADDR=quant:50051

# -------------------------
# Phase 8 扩展数据源（仅 quant worker 读取；gateway 不直接消费）
# -------------------------

# FRED (US/global macro)。空 → FRED source fail-closed 抛 ErrAPIKeyNotConfigured。
FRED_API_KEY=

# Etherscan (ETH on-chain)。空 → Etherscan source fail-closed。
ETHERSCAN_API_KEY=

# CryptoPanic news token。可选（空也工作，免费层限速更紧）。
CRYPTOPANIC_TOKEN=

# paid stubs — 设了也不会触发真实调用，需要先在 quant/pyproject.toml 加 SDK
# 并把 stub `__init__` 替换为真客户端。详见 CLAUDE.md §8。
# POLYGON_API_KEY=
# GLASSNODE_API_KEY=
# NANSEN_API_KEY=

# AI 优化器 extended context 开关。空 = 自动检测（FRED/Etherscan 任一设了即启用）；
# 显式 true/false 覆盖。开启不抬高 budget；超 budget 退化为基础上下文。
AI_CONTEXT_INCLUDE_EXTENDED=

# -------------------------
# AI 优化预算（仅 quant worker 读取）
# -------------------------

# Anthropic SDK key。空 → 优化器跳过 Claude，走默认 search space + 确定性 fallback。
ANTHROPIC_API_KEY=

# OpenAI key（可选，用于备选 LLM 渠道；当前 quant 默认走 Anthropic）。
OPENAI_API_KEY=

AI_MAX_USD_PER_STUDY=5.0           # 单 study USD 硬上限（fail-closed）
AI_MAX_USD_PER_DAY=50.0            # 全局每日 UTC USD 上限
AI_MAX_TRIALS_PER_STUDY=200        # Optuna trial 上限
AI_MAX_SECONDS_PER_STUDY=300       # Optuna wall-clock 硬截断（秒）
AI_OPTIMIZATION_DAILY_CRON="0 2 * * *"  # 仅支持 M H * * * 格式（含空格 & *，必须加引号）
AI_OPTIMIZATION_LOOKBACK_DAYS=90   # 默认 OHLCV 历史窗口（天）

# -------------------------
# Polymarket / Polygon（Phase 9）
# -------------------------

# Polygon RPC。默认公共节点 rate-limited；prod 切 Alchemy/Infura。
# 空 → 钱包 balance/positions/approve 端点 503 ErrRPCNotConfigured。
POLYGON_RPC_URL=https://polygon-rpc.com

POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# CTF Exchange contract override（仅 forked/staging 用；prod 默认空走官方地址）。
# POLYMARKET_CLOB_EXCHANGE_ADDRESS=

# -------------------------
# 可观测性（optional）
# -------------------------

# OTel OTLP endpoint。空 → trace 走 stdout（无意外数据外发）。
# 设 e.g. http://otel-collector:4318 切 OTLP HTTP。
OTEL_EXPORTER_OTLP_ENDPOINT=

# Token-bucket rate-limit backend。多副本部署改 redis。
RATELIMIT_BACKEND=memory

# Master KEK provider。env / aws-kms / gcp-kms（后两个为 stub，需 SDK swap）。
KEK_PROVIDER=env

# 仅当 KEK_PROVIDER=aws-kms：
# AWS_KMS_KEY_ID=
# AWS_REGION=

# 仅当 KEK_PROVIDER=gcp-kms：
# GCP_KMS_KEY_NAME=projects/<P>/locations/<L>/keyRings/<R>/cryptoKeys/<K>

# Audit 日志保留期（天）。默认 7 年（2557）；TTL 索引按 expiresAt 字段。
AUDIT_RETENTION_DAYS=

# -------------------------
# Runtime 调试（optional）
# -------------------------

# true → quant 长生命周期 strategy runtime 不启动（测试 / 冷启动）。
QUANT_RUNTIME_DISABLED=

# true → quant admin-ingest 消费 loop 不自动启动；cron 仍跑。
EXTENDED_CONSUMER_DISABLED=

# gateway 监听端口。
PORT=3001
