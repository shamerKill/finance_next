# Mongo connection string. Include database name in path segment.
# Example: mongodb+srv://user:pass@cluster.example.net/finance?retryWrites=true&w=majority
MONGODB_URI=

# 32-byte hex (64 hex chars). Used for AES-256-GCM encryption of stored exchange API credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# HTTP listen port (default 3001)
PORT=3001

# --- Phase 2 additions (all optional) ----------------------------------------

# TimescaleDB DSN (postgres://user:pass@host:5432/db). When unset, the
# /api/v1/market/ohlcv endpoint returns 503.
TIMESCALE_DSN=

# gRPC address of the Python quant worker (e.g. localhost:50051 or quant:50051).
# When unset, the admin /api/v1/market/ingest endpoint returns 503.
QUANT_GRPC_ADDR=

# Admin endpoint guard. When unset, the /api/v1/market/ingest endpoint
# returns 404 to hide its existence. When set, callers must send
# `X-Admin-Key: <value>` to be authorized.
ADMIN_KEY=

# Redis URL — Phase 3 backtest fan-out + Phase 4 order-engine queue.
# Format: redis://[:password@]host:port[/db].
REDIS_URL=

# --- Phase 4 additions (all optional) ----------------------------------------

# Binance mainnet trading kill-switch. Must be the literal string "true"
# (case-sensitive) to even *consider* mainnet calls. Default is testnet-only.
# A confirmed admin token (see /admin/mainnet/request-token + /confirm) is
# ALSO required at runtime — env alone does NOT open the gate.
MAINNET_TRADING_ENABLED=

# --- Phase 6 additions (all optional; quant worker reads these) -------------

# Anthropic SDK key. When unset, the optimizer skips every Claude call
# (default search space + deterministic fallback rationale) — useful in
# dev. The budget gate ALSO refuses when the projected cost would push
# spend past either cap below.
ANTHROPIC_API_KEY=

# Hard USD cap per study. Projected cost for any single Claude call
# that would push the per-study tally over this limit is REFUSED
# (fail-closed). Default: 5.0
AI_MAX_USD_PER_STUDY=

# Hard USD cap per UTC day, aggregated across all studies via Mongo
# `optimization_runs.cost.usdSpent`. Default: 50.0
AI_MAX_USD_PER_DAY=

# Optuna trial budget per study. Default: 200
AI_MAX_TRIALS_PER_STUDY=

# Optuna wall-clock cap per study (seconds). Default: 300
AI_MAX_SECONDS_PER_STUDY=

# Daily cron spec for the optimization loop. ONLY `M H * * *` syntax
# supported (no DOM/DOW/lists/ranges/steps). The worker REFUSES to
# start on a malformed value rather than silently falling back.
# Default: 0 2 * * * (02:00 UTC)
AI_OPTIMIZATION_DAILY_CRON=

# Lookback window (in days) for OHLCV pulled from Timescale per study.
# Default: 90
AI_OPTIMIZATION_LOOKBACK_DAYS=

# --- Phase 7 additions (all optional) ---------------------------------------

# Token-bucket rate-limit backend. "memory" (default) keeps state in-process;
# "redis" uses the REDIS_URL connection for cross-replica coordination.
RATELIMIT_BACKEND=

# OpenTelemetry trace exporter target. When unset, traces go to stdout
# (no surprise data egress). Set to e.g. http://otel-collector:4318 to
# ship via OTLP HTTP.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Audit retention in days. Defaults to 7 years (2557 days). Lowering
# this only affects newly-written rows; existing rows keep their TTL.
AUDIT_RETENTION_DAYS=

# Master KEK (Key Encryption Key) provider selector.
#   env     — default; uses ENCRYPTION_KEY (Phase 0/1 byte-compat)
#   aws-kms — stub today; needs AWS SDK build tag to ship
#   gcp-kms — stub today; needs GCP SDK build tag to ship
KEK_PROVIDER=

# AWS KMS configuration (only when KEK_PROVIDER=aws-kms).
AWS_KMS_KEY_ID=
AWS_REGION=

# GCP KMS configuration (only when KEK_PROVIDER=gcp-kms).
# Format: projects/<P>/locations/<L>/keyRings/<R>/cryptoKeys/<K>
GCP_KMS_KEY_NAME=

# --- Phase 8 additions (data sources; quant worker reads these) -------------
# Gateway itself only reads MONGODB_URI / TIMESCALE_DSN / REDIS_URL — the
# Phase 8 keys below live in the quant worker container's environment but
# are listed here so all repo-wide secrets stay in one example file.

# FRED (US/global macro). Free key from https://fred.stlouisfed.org/.
# Unset → FRED data source raises ErrAPIKeyNotConfigured (fail-closed).
FRED_API_KEY=

# Etherscan (ETH on-chain). Free key from https://etherscan.io/apis.
# Unset → Etherscan source raises ErrAPIKeyNotConfigured.
ETHERSCAN_API_KEY=

# CryptoPanic news. Optional — empty string still works on the free tier
# (lower rate limit). Set a token to lift the limit.
CRYPTOPANIC_TOKEN=

# AI optimizer extended context (Phase 8). When true the search-space
# Claude call is augmented with recent news + macro + on-chain summary.
# Costs are absorbed by the existing AI_MAX_USD_PER_STUDY budget gate
# (no extra try_charge step). Default: true iff FRED_API_KEY OR
# ETHERSCAN_API_KEY is set; otherwise false.
AI_CONTEXT_INCLUDE_EXTENDED=

# Disable the Phase 8 admin-ingest stream consumer in the quant worker.
# Mirrors QUANT_RUNTIME_DISABLED — set to true to skip auto-start in
# `quant.main` lifespan (the cron schedule still runs the periodic
# ingests). Leave unset in production.
EXTENDED_CONSUMER_DISABLED=

# Paid on-chain / equities sources — stubs today; setting these alone
# does not enable real calls (SDK swap-in required, see CLAUDE.md §7).
GLASSNODE_API_KEY=
NANSEN_API_KEY=
POLYGON_API_KEY=

# --- Phase 9 additions: Polymarket prediction-market vertical ----------------

# Polygon RPC URL. Default: https://polygon-rpc.com (free public node;
# rate-limited). Production should use Alchemy / Infura — set to a
# https://polygon-mainnet.g.alchemy.com/v2/<KEY> URL.
POLYGON_RPC_URL=

# Polymarket CLOB REST + Gamma metadata endpoints. Defaults below.
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# Polymarket trading kill-switch. Same shape as MAINNET_TRADING_ENABLED:
# must be the literal "true" to even consider order placement. The 3-gate
# (mode==mainnet + env==true + admin token confirmed) is hard-required;
# the admin token is shared with the perp engine via the singleton
# TokenStore, so /admin/mainnet/confirm opens BOTH verticals.
POLYMARKET_TRADING_ENABLED=

# CTF Exchange contract address override. Default is Polymarket's
# Polygon-mainnet operator at 0x4bFb41d5B3570DeFd03C39a9A4D8dE6Bd8B8982E.
# Override only when targeting a forked / staging deployment.
POLYMARKET_CLOB_EXCHANGE_ADDRESS=
